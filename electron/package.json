{
  "name": "vibe-view",
  "productName": "vibe-view",
  "version": "2.20.19",
  "description": "GPU-accelerated interactive 3D viewer for quantum-chemistry data",
  "main": "main.js",
  "scripts": {
    "start": "node node_modules/electron/cli.js .",
    "install-electron": "python3 install-electron.py",
    "make-icon": "python3 make-icon.py"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.vibeqc.vibeview",
    "productName": "vibe-view",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "icon.png",
      "python-runtime.cjs"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://vibe-qc.com/updates/vibe-view/"
    },
    "mac": {
      "category": "public.app-category.science",
      "icon": "icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "14.0",
      "extraResources": [
        {
          "from": ".runtime/macos-arm64/python",
          "to": "python"
        },
        {
          "from": ".runtime/macos-arm64/runtime.json",
          "to": "runtime.json"
        },
        {
          "from": ".runtime/macos-arm64/notices",
          "to": "third-party/python"
        }
      ]
    },
    "linux": {
      "icon": "icon.png",
      "category": "Science",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ]
    },
    "fileAssociations": [
      {
        "ext": "qvf",
        "name": "vibe-qc Visualization File",
        "description": "QVF Archive"
      },
      {
        "ext": "py",
        "name": "vibe-qc Python Input",
        "description": "vibe-qc Python Input",
        "role": "Viewer"
      },
      {
        "ext": [
          "gbw",
          "mcd",
          "hess"
        ],
        "name": "ORCA Calculation",
        "description": "ORCA GBW orbitals, HESS vibrations or MCD transitions",
        "role": "Viewer"
      },
      {
        "ext": [
          "xyz",
          "cif",
          "cube",
          "pdb",
          "mol2",
          "sdf",
          "mol",
          "gjf",
          "com",
          "gro"
        ],
        "name": "Chemistry Structure File",
        "description": "Chemistry structure and volume formats",
        "role": "Viewer"
      }
    ],
    "beforePack": "./before-pack.cjs",
    "afterPack": "./after-pack.cjs"
  },
  "author": "vibe-qc",
  "license": "MPL-2.0"
}
