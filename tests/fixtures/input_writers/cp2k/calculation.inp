&GLOBAL
 PROJECT calculation
 RUN_TYPE GEO_OPT
&END GLOBAL
&FORCE_EVAL
 METHOD Quickstep
 &DFT
  BASIS_SET_FILE_NAME BASIS_MOLOPT
  POTENTIAL_FILE_NAME GTH_POTENTIALS
  CHARGE 0
  MULTIPLICITY 1
  UKS F
  &MGRID
   CUTOFF 400
  &END MGRID
  &POISSON
   PERIODIC NONE
   POISSON_SOLVER ANALYTIC
  &END POISSON
  &XC
   &XC_FUNCTIONAL PBE
   &END XC_FUNCTIONAL
  &END XC
 &END DFT
 &SUBSYS
  &CELL
   A 12.000000000000 0.000000000000 0.000000000000
   B 0.000000000000 12.000000000000 0.000000000000
   C 0.000000000000 0.000000000000 12.000000000000
   PERIODIC NONE
  &END CELL
  &COORD
O 0.000000000000 0.000000000000 0.000000000000
H 0.758000000000 0.000000000000 0.504000000000
H -0.758000000000 0.000000000000 0.504000000000
  &END COORD
  &KIND O
   BASIS_SET DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q6
  &END KIND
  &KIND H
   BASIS_SET DZVP-MOLOPT-SR-GTH
   POTENTIAL GTH-PBE-q1
  &END KIND
 &END SUBSYS
&END FORCE_EVAL
&MOTION
 &CONSTRAINT
  &FIXED_ATOMS
   LIST 1 3
   COMPONENTS_TO_FIX XYZ
  &END FIXED_ATOMS
 &END CONSTRAINT
&END MOTION

